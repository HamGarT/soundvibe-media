# Copiar a .env y cambiar TODOS los valores marcados antes de desplegar.
# El .env real nunca se commitea (ver .gitignore).

APP_ENV=development
PORT=8092

# --- soundvibe-core --------------------------------------------------------
# Dentro de la red de compose se resuelve por nombre de contenedor. Fuera de
# Docker, usar http://localhost:8091.
CORE_BASE_URL=http://sv-core-api:8091
CORE_TIMEOUT_SECONDS=5

# Tiene que ser EXACTAMENTE el mismo valor que INTERNAL_API_KEY en el .env de
# soundvibe-core. Si no coinciden, todos los joins fallan con core_unavailable.
INTERNAL_API_KEY=clave-compartida-con-soundvibe-core

# --- LiveKit ---------------------------------------------------------------
# El par key/secret se comparte entre el SFU (via LIVEKIT_KEYS en el compose) y
# signaling, que firma los tokens con el.
#   Generar el secreto con: openssl rand -base64 48
LIVEKIT_API_KEY=APIcambiaesto
LIVEKIT_API_SECRET=cambia-esto-minimo-32-caracteres-de-verdad

# URL que se le entrega al cliente para conectarse al SFU.
# Local: ws://localhost:7880   Produccion: wss://livekit.tudominio.com
LIVEKIT_URL=ws://localhost:7880

# Vida del token de LiveKit. Corta a proposito: solo hace falta para entrar al
# room, no para seguir conectado.
LIVEKIT_TOKEN_TTL_MINUTES=10

# --- Dominios (solo para el perfil `proxy` con Caddy) ----------------------
# Los tres deben apuntar por DNS a la IP del VPS antes de levantar Caddy.
CORE_DOMAIN=api.tudominio.com
SIGNALING_DOMAIN=signaling.tudominio.com
LIVEKIT_DOMAIN=livekit.tudominio.com
ACME_EMAIL=tu-email@tudominio.com
