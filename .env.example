# Copiar a .env y cambiar TODOS los valores marcados antes de desplegar.
# El .env real nunca se commitea (ver .gitignore).

APP_ENV=development
PORT=8092

# --- soundvibe-core --------------------------------------------------------
# Dentro de la red de compose se resuelve por nombre de contenedor. Fuera de
# Docker, usar http://localhost:8091.
CORE_BASE_URL=http://sv-core-api:8091
CORE_TIMEOUT_SECONDS=5

# Tiene que ser EXACTAMENTE el mismo valor que INTERNAL_API_KEY en el .env de
# soundvibe-core. Si no coinciden, todos los joins fallan con core_unavailable.
INTERNAL_API_KEY=clave-compartida-con-soundvibe-core

# --- LiveKit ---------------------------------------------------------------
# El par key/secret se comparte entre el SFU (via LIVEKIT_KEYS en el compose) y
# signaling, que firma los tokens con el.
#   Generar el secreto con: openssl rand -base64 48
LIVEKIT_API_KEY=APIcambiaesto
LIVEKIT_API_SECRET=cambia-esto-minimo-32-caracteres-de-verdad

# URL que se le entrega al cliente para conectarse al SFU.
# Local: ws://localhost:7880   Produccion: wss://livekit.tudominio.com
# En el VPS TIENE que ser wss://. Android bloquea el trafico en claro, asi que
# con ws:// el oyente entra al room y no escucha nada — y el servidor no reporta
# ningun error, porque el fallo es del lado del cliente.
#   LIVEKIT_URL=wss://livekit.tudominio.com
# En local, ws:// contra localhost esta bien.
LIVEKIT_URL=ws://localhost:7880

# URL HTTP de la API de administracion del SFU, usada para expulsar a quien
# pierde el permiso mientras esta escuchando. Distinta de LIVEKIT_URL: esta no
# pasa por el reverse proxy ni la ve ningun cliente.
#
# Con LiveKit en network_mode: host y signaling en bridge, se lo alcanza por el
# gateway del host (ver extra_hosts en docker-compose.yml).
# Vacio = revocacion en vivo deshabilitada (se avisa en el log al arrancar).
LIVEKIT_API_URL=http://host.docker.internal:7880

# Por donde el RELAY se conecta al SFU para publicar el audio del host.
#
# Distinta de LIVEKIT_URL, que es la que se le entrega al cliente: alcanzar la
# publica desde dentro del contenedor obliga a salir del VPS, resolver DNS
# publico y volver a entrar por el reverse proxy. En la mayoria de las redes eso
# no funciona y el sintoma es "could not establish signal connection".
#
# NO es el nombre del contenedor: el SFU corre con network_mode: host, asi que
# no existe ningun `sv-livekit` que resolver por DNS de Docker. Se llega igual
# que a la API de administracion, por el gateway del host (para eso esta
# extra_hosts: host.docker.internal:host-gateway en el compose).
#
# Si se deja vacia se usa LIVEKIT_URL, que en el VPS falla con
# "could not establish signal connection".
LIVEKIT_INTERNAL_URL=ws://host.docker.internal:7880

# Vida del token de LiveKit. Corta a proposito: solo hace falta para entrar al
# room, no para seguir conectado.
LIVEKIT_TOKEN_TTL_MINUTES=10

# --- Dominios (solo para el perfil `proxy` con Caddy) ----------------------
# Los tres deben apuntar por DNS a la IP del VPS antes de levantar Caddy.
CORE_DOMAIN=api.tudominio.com
SIGNALING_DOMAIN=signaling.tudominio.com
LIVEKIT_DOMAIN=livekit.tudominio.com
ACME_EMAIL=tu-email@tudominio.com
